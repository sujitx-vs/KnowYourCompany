# ============================================================
# KNOWYOURCOMPANY ENVIRONMENT CONFIGURATION
# ============================================================

# LLM and Search APIs
GOOGLE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# Supabase Configuration (Backend only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage Bucket for PDF reports (Private bucket)
SUPABASE_STORAGE_BUCKET=placement-reports

# Supabase Postgres Connection String (for LangGraph checkpointer persistence)
# Format: postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=

# Frontend URL for CORS (e.g., http://localhost:3000 or your deployed Vercel domain)
FRONTEND_URL=http://localhost:3000
