# Runtime
APP_ENV=development
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Local SQLite path, or PostgreSQL URL in production. Never expose this to Next.js.
RUN_DATABASE_URL=outputs/research.sqlite3
# Legacy SUPABASE_DB_URL / DATABASE_URL are accepted when RUN_DATABASE_URL is empty.
EMBEDDED_WORKER=true
WORKER_CONCURRENCY=2

# Research providers (at least one search provider is needed)
GOOGLE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
TAVILY_SEARCH_DEPTH=basic
SEARCH_QUERY_CONCURRENCY=3
SEARCH_TIMEOUT_SECONDS=18
PROVIDER_ATTEMPTS=2
RUN_PHASE_TIMEOUT_SECONDS=240
EVIDENCE_BYTE_BUDGET=24000

# Public evidence caching. A complete brief expires no later than its news.
RESEARCH_CACHE_ENABLED=true
SEARCH_CACHE_ENABLED=true
COMPANY_CACHE_TTL_SECONDS=1800
NEWS_SEARCH_TTL_SECONDS=1800
STABLE_SEARCH_TTL_SECONDS=21600

# Quotas count rolling 24-hour run submissions, including failed/cancelled runs.
DAILY_RUN_LIMIT=10
IP_DAILY_RUN_LIMIT=30
GLOBAL_DAILY_RUN_LIMIT=200

# Production requires private Supabase Storage; local development can use REPORT_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=placement-reports
REPORT_DIR=outputs

# Optional operator dashboard. Generate a random key of at least 32 characters.
ADMIN_API_KEY=
# Fill in your actual prices; unknown prices remain unknown in the dashboard.
# Model values: {"model-name":{"input":USD_PER_MILLION,"output":USD_PER_MILLION}}
MODEL_PRICES_JSON={}
# Search values: {"tavily":USD_PER_REQUEST,"exa":USD_PER_REQUEST}
SEARCH_PRICES_JSON={}
